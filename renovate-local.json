{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchPaths": ["nix/packages/broadcast-box/**"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchPaths": ["nix/packages/donetick-frontend/**"],
      "enabled": false
    },
    {
      "matchDepTypes": ["requires-python"],
      "matchPaths": ["nix/packages/carvera-controller/**"],
      "enabled": false
    },
    {
      "description": "One rule for both: executionMode branch only runs the tasks of the first upgrade in a branch, so a grouped vpn+packetfox bump must regenerate both hashes",
      "matchManagers": ["gomod"],
      "matchFileNames": ["vpn/**", "packetfox/**"],
      "postUpgradeTasks": {
        "commands": [
          "/repo/tools/auto-nix-hash vpn/vendor-hash.txt ./nix#nixosConfigurations.islandfox.pkgs.foxden-vpn.goModules",
          "/repo/tools/auto-nix-hash packetfox/vendor-hash.txt ./nix#nixosConfigurations.islandfox.pkgs.packetfox.goModules"
        ],
        "executionMode": "branch"
      }
    }
  ]
}
