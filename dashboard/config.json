{
  "title": "FoxDen Rack",
  "listen": ":8080",
  "units": 23,
  "interval": "15s",
  "timeout": "10s",
  "snmp": {
    "community": "${SNMP_COMMUNITY}"
  },
  "devices": [
    {
      "id": "spares",
      "name": "spares shelf",
      "module": "shelf",
      "u": 22
    },
    {
      "id": "kvm-rack",
      "module": "generic",
      "u": 21,
      "address": "kvm-rack.foxden.network"
    },
    {
      "id": "bengalfox",
      "module": "supermicro-cse826",
      "u": 16,
      "address": "bengalfox.foxden.network"
    },
    {
      "id": "tape-library",
      "module": "ibm-ts3100",
      "u": 14,
      "address": "tape-library.foxden.network"
    },
    {
      "id": "shelf",
      "module": "shelf",
      "u": 12,
      "height": 2,
      "children": [
        {
          "id": "islandfox",
          "module": "mini-pc",
          "address": "islandfox.foxden.network",
          "width": 2
        },
        {
          "id": "ntpi",
          "module": "raspberry-pi",
          "address": "ntpi.foxden.network"
        }
      ]
    },
    {
      "id": "switch-rack",
      "module": "unifi-us-48",
      "u": 11,
      "address": "switch-rack.foxden.network"
    },
    {
      "id": "brush-10",
      "name": "brush panel",
      "module": "unifi-brush-panel",
      "u": 10
    },
    {
      "id": "switch-rack-agg",
      "module": "unifi-usw-pro-aggregation",
      "u": 9,
      "address": "switch-rack-agg.foxden.network"
    },
    {
      "id": "router",
      "module": "mikrotik-ccr2004-1g-12s-2xs",
      "u": 8,
      "address": "router.foxden.network",
      "options": {
        "groups": [
          {
            "label": "MGMT",
            "ports": "oob",
            "labels": "MGMT",
            "rows": 1
          },
          {
            "label": "SFP+",
            "ports": "sfp{1..11},wan",
            "labels": "{1..12}",
            "rows": 2
          },
          {
            "label": "SFP28",
            "ports": "vlan-mgmt,sfpx2",
            "labels": "1,2",
            "rows": 2
          }
        ]
      }
    },
    {
      "id": "router-backup",
      "module": "mikrotik-rb5009",
      "u": 7,
      "address": "router-backup.foxden.network",
      "options": {
        "groups": [
          {
            "label": "RJ45",
            "ports": "wan,eth{2..7},oob",
            "labels": "{1..8}",
            "rows": 1
          },
          {
            "label": "SFP+",
            "ports": "vlan-mgmt",
            "labels": "SFP+",
            "rows": 1
          }
        ]
      }
    },
    {
      "id": "pdu-rack",
      "module": "unifi-pdu-pro",
      "u": 5,
      "address": "pdu-rack.foxden.network",
      "options": {
        "controller": "https://unifi.foxden.network",
        "mac": "70:a7:41:f8:13:09"
      }
    },
    {
      "id": "nvr",
      "module": "unifi-unvr",
      "u": 4,
      "address": "nvr.foxden.network"
    },
    {
      "id": "brush-3",
      "name": "brush panel",
      "module": "unifi-brush-panel",
      "u": 3
    },
    {
      "id": "ups-rack",
      "module": "eaton-5px-2u",
      "u": 1,
      "address": "ups-rack.foxden.network",
      "options": {
        "ats": {
          "model": "cyberpower",
          "address": "ats-rack.foxden.network"
        }
      }
    }
  ],
  "remote": [
    {
      "name": "OVH",
      "devices": [
        {
          "id": "icefox",
          "module": "server",
          "address": "icefox.foxden.network"
        }
      ]
    }
  ]
}
