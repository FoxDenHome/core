        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "pluginVersion": "4.23.2",
                        "queryType": "table",
                        "rawSql": "SELECT sum(flows) / 600 AS flows FROM netflow.inbound_1m WHERE minute >= now() - INTERVAL 10 MINUTE"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
