      "panel-7": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "pluginVersion": "4.23.2",
                        "queryType": "timeseries",
                        "rawSql": "SELECT toStartOfInterval(minute, INTERVAL $__interval_s second) AS time, concat(proto, '/', toString(dst_port)) AS service, sum(flows) / $__interval_s AS flows\nFROM netflow.inbound_1m\nWHERE $__timeFilter(minute) AND dst_port IN (\n    SELECT dst_port FROM netflow.inbound_1m\n    WHERE $__timeFilter(minute)\n    GROUP BY dst_port ORDER BY sum(flows) DESC LIMIT 8\n  )\nGROUP BY time, service ORDER BY time"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
