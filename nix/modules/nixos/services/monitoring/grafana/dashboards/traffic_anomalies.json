    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "pluginVersion": "4.23.2",
                        "queryType": "table",
                        "rawSql": "SELECT max(ratio) AS ratio FROM (WITH\n  recent AS (\n    SELECT proto, dst_port, uniqMerge(sources) AS sources, uniqMerge(prefixes) AS prefixes, sum(flows) AS flows\n    FROM netflow.inbound_1m\n    WHERE minute >= now() - INTERVAL 10 MINUTE\n    GROUP BY proto, dst_port\n  ),\n  baseline AS (\n    SELECT proto, dst_port, quantile(0.95)(sources) AS p95\n    FROM (\n      SELECT proto, dst_port, toStartOfTenMinutes(minute) AS bucket, uniqMerge(sources) AS sources\n      FROM netflow.inbound_1m\n      WHERE minute BETWEEN now() - INTERVAL 7 DAY AND now() - INTERVAL 1 HOUR\n      GROUP BY proto, dst_port, bucket\n    )\n    GROUP BY proto, dst_port\n  )\nSELECT\n  concat(r.proto, '/', toString(r.dst_port)) AS service,\n  r.sources AS sources,\n  r.prefixes AS prefixes,\n  r.flows AS flows,\n  round(b.p95) AS baseline_p95,\n  round(r.sources / greatest(b.p95, 20), 1) AS ratio\nFROM recent AS r\nLEFT JOIN baseline AS b ON r.proto = b.proto AND r.dst_port = b.dst_port)"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Worst service: unique external sources in the last 10 minutes divided by its 7-day p95 (floor 20). Alerts at 5 with at least 200 sources.",
          "id": 1,
          "links": [],
          "title": "Highest anomaly ratio (10m)",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "x",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "orange",
                        "value": 3
                      },
                      {
                        "color": "red",
                        "value": 5
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "colorMode": "background"
              }
            },
            "version": "13.0.2"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "pluginVersion": "4.23.2",
                        "queryType": "table",
                        "rawSql": "SELECT uniqMerge(sources) AS sources FROM netflow.inbound_1m WHERE minute >= now() - INTERVAL 10 MINUTE"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Unique external addresses opening inbound connections in the last 10 minutes.",
          "id": 2,
          "links": [],
