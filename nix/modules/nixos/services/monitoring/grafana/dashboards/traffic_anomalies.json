      "panel-8": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "pluginVersion": "4.23.2",
                        "queryType": "timeseries",
                        "rawSql": "SELECT toStartOfInterval(time_received, INTERVAL $__interval_s second) AS time,\n  sumIf(bytes, src_external) * 8 / $__interval_s AS inbound,\n  sumIf(bytes, NOT src_external AND dst_external) * 8 / $__interval_s AS outbound\nFROM netflow.flows\nWHERE $__timeFilter(time_received)\nGROUP BY time ORDER BY time"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Bytes from external addresses (inbound) and from our own addresses to external ones (outbound). Our dynamic public IPv4 counts as external, so check this against the routers' WAN counters once real IPFIX data is in.",
          "id": 8,
          "links": [],
          "title": "WAN throughput",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "bps"
                },
                "overrides": []
              },
              "options": {}
            },
            "version": "13.0.2"
          }
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "pluginVersion": "4.23.2",
                        "queryType": "table",
                        "rawSql": "SELECT * FROM (WITH\n  recent AS (\n    SELECT proto, dst_port, uniqMerge(sources) AS sources, uniqMerge(prefixes) AS prefixes, sum(flows) AS flows\n    FROM netflow.inbound_1m\n    WHERE minute >= now() - INTERVAL 10 MINUTE\n    GROUP BY proto, dst_port\n  ),\n  baseline AS (\n    SELECT proto, dst_port, quantile(0.95)(sources) AS p95\n    FROM (\n      SELECT proto, dst_port, toStartOfTenMinutes(minute) AS bucket, uniqMerge(sources) AS sources\n      FROM netflow.inbound_1m\n      WHERE minute BETWEEN now() - INTERVAL 7 DAY AND now() - INTERVAL 1 HOUR\n      GROUP BY proto, dst_port, bucket\n    )\n    GROUP BY proto, dst_port\n  )\nSELECT\n  concat(r.proto, '/', toString(r.dst_port)) AS service,\n  r.sources AS sources,\n  r.prefixes AS prefixes,\n  r.flows AS flows,\n  round(b.p95) AS baseline_p95,\n  round(r.sources / greatest(b.p95, 20), 1) AS ratio\nFROM recent AS r\nLEFT JOIN baseline AS b ON r.proto = b.proto AND r.dst_port = b.dst_port) ORDER BY ratio DESC LIMIT 20"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Same query as the alert. ratio = sources / max(p95, 20). prefixes close to sources means the traffic is spread across many networks.",
          "id": 9,
          "links": [],
          "title": "Anomaly score by service (10m vs 7d p95)",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              },
