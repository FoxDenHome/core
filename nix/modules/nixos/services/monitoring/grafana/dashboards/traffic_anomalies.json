      "panel-10": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "pluginVersion": "4.23.2",
                        "queryType": "table",
                        "rawSql": "SELECT IPv6NumToString(src_addr) AS source, count() AS flows, sum(bytes) AS bytes, uniq(dst_port) AS ports, min(time_received) AS first_seen, max(time_received) AS last_seen\nFROM netflow.flows\nWHERE $__timeFilter(time_received) AND inbound\nGROUP BY src_addr ORDER BY flows DESC LIMIT 25"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
