      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "pluginVersion": "4.23.2",
                        "queryType": "timeseries",
                        "rawSql": "SELECT toStartOfInterval(time_received, INTERVAL $__interval_s second) AS time, IPv6NumToString(sampler) AS router, count() / $__interval_s AS records\nFROM netflow.flows\nWHERE $__timeFilter(time_received)\nGROUP BY time, router ORDER BY time"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Exporter health: records received per router. Flat zero means traffic-flow or goflow2 broke.",
          "id": 4,
          "links": [],
          "title": "Flow records/s by router",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "short"
                },
                "overrides": []
              },
              "options": {}
            },
            "version": "13.0.2"
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 0,
                        "pluginVersion": "4.23.2",
                        "queryType": "timeseries",
                        "rawSql": "SELECT toStartOfInterval(minute, INTERVAL $__interval_s second) AS time, concat(proto, '/', toString(dst_port)) AS service, uniqMerge(sources) AS sources\nFROM netflow.inbound_1m\nWHERE $__timeFilter(minute) AND dst_port IN (\n    SELECT dst_port FROM netflow.inbound_1m\n    WHERE $__timeFilter(minute)\n    GROUP BY dst_port ORDER BY sum(flows) DESC LIMIT 8\n  )\nGROUP BY time, service ORDER BY time"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "The botnet signal: how many distinct addresses hit each listening port, top 8 ports by flows.",
