      "panel-11": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "pluginVersion": "4.23.2",
                        "queryType": "table",
                        "rawSql": "SELECT cutIPv6(src_addr, 10, 1) AS network, uniq(src_addr) AS sources, count() AS flows, groupUniqArray(5)(dst_port) AS ports\nFROM netflow.flows\nWHERE $__timeFilter(time_received) AND inbound\nGROUP BY network ORDER BY flows DESC LIMIT 25"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Inbound flows grouped by source prefix. Many prefixes with a handful of addresses each looks like a residential proxy botnet.",
          "id": 11,
          "links": [],
          "title": "Top source networks (/24, /48)",
